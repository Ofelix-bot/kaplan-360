# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Supabase (Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (legacy name: anon key). Safe in the browser; access is limited by row-level security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (legacy name: service_role key). Server and data pipeline only; never in the browser.
SUPABASE_SECRET_KEY=

# Anthropic (https://console.anthropic.com → API Keys). Used by the data pipeline for field extraction.
ANTHROPIC_API_KEY=
# The AI adviser's model (lib/agent/run.ts, lib/agent/audit.ts); empty for the default, claude-sonnet-5-5.
AGENT_MODEL=
