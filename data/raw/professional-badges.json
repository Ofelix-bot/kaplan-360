  "rules": {
    "psychology": {
      "text": "SRP registration needs a postgraduate applied-psychology master's or doctorate (minimum 2 years full-time, with assessment/intervention coursework, supervised practicum and a thesis) that enables practice as a psychologist and, if overseas, is accredited by that country's psychological society or registration body; counselling, psychotherapy, family therapy, behaviour analysis and research-only degrees do not qualify.",
      "url": "https://psychology.org.sg/srp_membership/srp/"
    },
    "accounting": {
      "text": "Only the listed direct-entry degrees (including NTU's MSc Accountancy and SMU's Master of Professional Accounting) admit straight to the Singapore CA Qualification Professional Programme; any other accredited or ACRA-recognised degree must first complete the SCAQ Foundation Programme.",
      "url": "https://isca.org.sg/qualifications/scaq/professional-programme"
    },
    "law": {
      "text": "A Qualified Person must hold an applicable law degree (LL.B or, from listed Australian and US schools, a J.D.) from a university in the Legal Profession (Qualified Persons) Rules schedules, rank in the top 70% of the cohort, and be a Singapore citizen or PR when it is conferred.",
      "url": "https://www.sile.edu.sg/United-States-of-America-Approved-Universities"
    }
  },
